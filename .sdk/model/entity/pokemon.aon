# Entity: pokemon

main: kit: entity: pokemon: {

  alias: field: {}

  fields: [
    {
      name: "availableForms"
      req: false
      short: "All available forms for this Pokémon"
      type: "`$ARRAY`"
    }
    {
      name: "fileSize"
      req: false
      short: "Size of the model file in bytes"
      type: "`$INTEGER`"
    }
    {
      name: "form"
      req: false
      short: "Current form of the Pokémon"
      type: "`$STRING`"
    }
    {
      name: "forms"
      req: false
      short: "Available forms for this Pokémon"
      type: "`$ARRAY`"
    }
    {
      name: "generation"
      req: false
      short: "Generation the Pokémon belongs to"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the Pokémon"
      type: "`$INTEGER`"
    }
    {
      name: "modelFormat"
      req: false
      short: "Format of the 3D model"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "modelUrl"
      req: false
      short: "URL to the 3D model file (GLB/GLTF format)"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of the Pokémon"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "textureUrl"
      req: false
      short: "URL to the texture file"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "thumbnailUrl"
      req: false
      short: "URL to the thumbnail image"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "Pokémon types"
      type: "`$ARRAY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "pokemon"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 100
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 0
                kind: "query"
                name: "offset"
                orig: "offset"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/pokemons"
          segments: [
            {
              lit: "pokemons"
            }
          ]
          select: {
            exist: [
              "limit"
              "offset"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "form"
                orig: "form"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/pokemons/{id}"
          segments: [
            {
              lit: "pokemons"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "form"
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
