# Guide

guide: {
  metrics: count: entity: 1
  metrics: count: path: 2
  metrics: count: method: 2

  entity: pokemon: {
    path: "/pokemons": {
      op: list: method: *GET
      op: list: transform: res: *("`body.results`")|top
    }
    path: "/pokemons/{id}": {
      op: load: method: *GET
    }
  }

}